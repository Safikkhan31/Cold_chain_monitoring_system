# MQTT broker (from: terraform output -raw mqtt_host)
MQTT_URL=mqtt://YOUR_MQTT_HOST:1883
MQTT_USER=esp32
# from: terraform output -raw mqtt_esp32_password
MQTT_PASS=YOUR_MQTT_PASSWORD

# Box IDs are BOX-002 ... BOX-021 (BOX-001 is kept for your real/Wokwi box)
BOX_START=2
BOX_COUNT=20

# Seconds between messages from each box (the real firmware uses 10)
INTERVAL_S=10
# Time acceleration. Each message counts as INTERVAL_S x SPEED seconds, so an "hour out of range"
# takes only a few minutes to show. Use SPEED=1 for real time.
SPEED=30
